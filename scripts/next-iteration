#!/bin/bash

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  ./scripts/next-iteration
  ./scripts/next-iteration -i docs/iterations/030-something.md

Selects the current iteration doc from `docs/iterations/` based on `#status/*`
tags and prints a clean-context prompt (preamble) plus the chosen iteration doc
contents.

Selection rules:
- Any `.md` file under `docs/iterations/` is eligible unless it is `#status/finished`.
- Files missing a `#status/*` line are treated as `draft` for selection.
- If multiple docs are eligible, selection requires `fzf`.
- After selection, this script ensures exactly one `#status/active` doc:
  - chosen doc is set to `#status/active` (adding a status line if missing)
  - any other doc currently `#status/active` is demoted to `#status/finished` with a note

Output goes to stdout so it can be piped into an agent runner.
EOF
}

ITERATION_FILE=""

while getopts ":i:h" opt; do
  case "$opt" in
    i) ITERATION_FILE="$OPTARG" ;;
    h) usage; exit 0 ;;
    *) usage; exit 2 ;;
  esac
done

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"
ITERATIONS_DIR="$ROOT_DIR/docs/iterations"

if [ ! -d "$ITERATIONS_DIR" ]; then
  echo "Error: Missing: docs/iterations" >&2
  exit 1
fi

if [ -n "$ITERATION_FILE" ] && [[ "$ITERATION_FILE" != /* ]]; then
  ITERATION_FILE="$ROOT_DIR/$ITERATION_FILE"
fi

if ! command -v python3 >/dev/null 2>&1; then
  echo "Error: python3 is required." >&2
  exit 1
fi

if [ -z "$ITERATION_FILE" ] && ! command -v fzf >/dev/null 2>&1; then
  # If we end up with multiple eligible docs, we will need fzf.
  echo "Error: fzf is required unless you pass -i <iteration_file>." >&2
  exit 1
fi

choose_and_normalize() {
  python3 - "$ROOT_DIR" "$ITERATIONS_DIR" "$ITERATION_FILE" <<'PY'
import json
import os
import re
import sys
from datetime import date

root = sys.argv[1]
iterations_dir = sys.argv[2]
explicit = sys.argv[3] if len(sys.argv) > 3 else ""

status_re = re.compile(r"^#status/([A-Za-z0-9_-]+)\s*$")

def read_lines(path: str) -> list[str]:
  with open(path, "r", encoding="utf-8") as f:
    return f.read().splitlines(True)

def write_lines(path: str, lines: list[str]) -> None:
  with open(path, "w", encoding="utf-8") as f:
    f.write("".join(lines))

def find_status_index(lines: list[str]):
  for i, line in enumerate(lines):
    m = status_re.match(line.rstrip("\n"))
    if m:
      return i, m.group(1)
  return None, None

def has_note(lines: list[str]) -> bool:
  for line in lines[:12]:
    if line.startswith("> Status updated by next-iteration"):
      return True
  return False

def set_status(lines: list[str], new_status: str, *, note: bool) -> list[str]:
  idx, _ = find_status_index(lines)
  if idx is None:
    lines = [f"#status/{new_status}\n", "\n"] + lines
    idx = 0
  else:
    lines[idx] = f"#status/{new_status}\n"

  if note and not has_note(lines):
    insert_at = idx + 1
    lines[insert_at:insert_at] = [
      f"> Status updated by next-iteration ({date.today().isoformat()}).\n",
      "\n",
    ]
  return lines

paths: list[str] = []
for name in os.listdir(iterations_dir):
  if not name.endswith(".md"):
    continue
  paths.append(os.path.join(iterations_dir, name))

paths.sort()

items = []
for p in paths:
  rel = os.path.relpath(p, root)
  lines = read_lines(p)
  _, status = find_status_index(lines)
  status = status or "draft"
  items.append({"path": p, "rel": rel, "status": status})

eligible = [it for it in items if it["status"] != "finished"]
if not eligible:
  print(json.dumps({"error": "no_eligible"}))
  raise SystemExit(0)

chosen = None
if explicit:
  exp_abs = os.path.abspath(explicit)
  for it in eligible:
    if os.path.abspath(it["path"]) == exp_abs:
      chosen = it
      break
  if chosen is None:
    print(json.dumps({"error": "explicit_not_eligible", "explicit": os.path.relpath(exp_abs, root)}))
    raise SystemExit(0)

out = {
  "eligible": [{"rel": it["rel"], "status": it["status"]} for it in eligible],
  "chosen": {"rel": chosen["rel"], "status": chosen["status"]} if chosen else None,
}

print(json.dumps(out))
PY
}

selection_json="$(choose_and_normalize)"
err=$(python3 -c 'import json,sys; print(json.loads(sys.stdin.read()).get("error",""))' <<<"$selection_json")

if [ "$err" = "no_eligible" ]; then
  echo "Error: No eligible iteration docs found (everything is #status/finished)." >&2
  exit 1
fi

if [ "$err" = "explicit_not_eligible" ]; then
  rel=$(python3 -c 'import json,sys; print(json.loads(sys.stdin.read()).get("explicit",""))' <<<"$selection_json")
  echo "Error: Provided -i file is not eligible: $rel" >&2
  exit 1
fi

ELIGIBLE_COUNT=$(python3 -c 'import json,sys; print(len(json.loads(sys.stdin.read())["eligible"]))' <<<"$selection_json")
CHOSEN_REL=""

if [ -n "$ITERATION_FILE" ]; then
  CHOSEN_REL=$(python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["chosen"]["rel"])' <<<"$selection_json")
elif [ "$ELIGIBLE_COUNT" -eq 1 ]; then
  CHOSEN_REL=$(python3 -c 'import json,sys; print(json.loads(sys.stdin.read())["eligible"][0]["rel"])' <<<"$selection_json")
else
  choices=$(python3 - <<'PY' "$selection_json"
import json
import sys

data = json.loads(sys.argv[1])
rows = []
for it in data["eligible"]:
  rows.append(f"{it['status']}\t{it['rel']}")
print("\n".join(rows))
PY
)

  picked=$(printf "%s\n" "$choices" | fzf --prompt="Select iteration doc > " --with-nth=1,2 --delimiter=$'\t')
  if [ -z "$picked" ]; then
    echo "Error: No selection made." >&2
    exit 1
  fi
  CHOSEN_REL=$(printf "%s" "$picked" | awk -F $'\t' '{print $2}')
fi

python3 - "$ROOT_DIR" "$ITERATIONS_DIR" "$CHOSEN_REL" <<'PY'
import os
import re
import sys
from datetime import date

root = sys.argv[1]
iterations_dir = sys.argv[2]
chosen_rel = sys.argv[3]

status_re = re.compile(r"^#status/([A-Za-z0-9_-]+)\s*$")

def read_lines(path: str) -> list[str]:
  with open(path, "r", encoding="utf-8") as f:
    return f.read().splitlines(True)

def write_lines(path: str, lines: list[str]) -> None:
  with open(path, "w", encoding="utf-8") as f:
    f.write("".join(lines))

def find_status_index(lines: list[str]):
  for i, line in enumerate(lines):
    m = status_re.match(line.rstrip("\n"))
    if m:
      return i, m.group(1)
  return None, None

def ensure_status(lines: list[str], default_status: str) -> list[str]:
  idx, _ = find_status_index(lines)
  if idx is not None:
    return lines
  return [f"#status/{default_status}\n", "\n"] + lines

def has_note(lines: list[str]) -> bool:
  for line in lines[:12]:
    if line.startswith("> Status updated by next-iteration"):
      return True
  return False

def set_status(lines: list[str], new_status: str, *, note: bool) -> list[str]:
  idx, _ = find_status_index(lines)
  if idx is None:
    lines = [f"#status/{new_status}\n", "\n"] + lines
    idx = 0
  else:
    lines[idx] = f"#status/{new_status}\n"
  if note and not has_note(lines):
    insert_at = idx + 1
    lines[insert_at:insert_at] = [
      f"> Status updated by next-iteration ({date.today().isoformat()}).\n",
      "\n",
    ]
  return lines

chosen_abs = os.path.join(root, chosen_rel)

for name in os.listdir(iterations_dir):
  if not name.endswith(".md"):
    continue
  path = os.path.join(iterations_dir, name)
  lines = read_lines(path)
  _, status = find_status_index(lines)

  if os.path.abspath(path) == os.path.abspath(chosen_abs):
    lines = ensure_status(lines, "draft")
    lines = set_status(lines, "active", note=False)
  else:
    if status == "active":
      lines = set_status(lines, "finished", note=True)

  write_lines(path, lines)
PY

cat <<'EOF'
You are a Process Engineer and Package Maintainer working in the `simple-agentic-process-setup` kit repository.

Your task: work on the chosen iteration document.

How to proceed (keep this lightweight):

1) Read the iteration doc fully.
2) Answer any `#question`/`#clarify` items directly in the doc.
3) If the doc contains an **Agent Action** block, do the work.
   - Prefer focused, surgical changes.
   - If you add a process capability, ensure it is “Done” by the kit rules:
     - artifact exists under `payload/` (docs/scripts/prompts)
     - installer installs it (anything under `payload/` + executable bits in `scaffold-project.py` if needed)
     - `payload/AGENTS-additions.md` explains usage (if applicable)
     - if you need to ask questions or seek clarification, append a section to the doc with them. Use `#agent-question` and `#agent-clarify` tags so it remains clear who is asking and who is clarifying.
4) Preserve the separation between maintainer docs (`docs/`) and consumer-installed docs (`payload/docs/`).
5) Update the iteration doc with:
   - decisions made
   - what changed
   - next steps / remaining questions

Stop conditions (write into the iteration doc and stop):

- Requirements unclear or conflicting
- You would need to delete/move lots of files without explicit instruction

---
EOF

echo "File: $CHOSEN_REL"
echo "---"
cat "$ROOT_DIR/$CHOSEN_REL"
echo ""
