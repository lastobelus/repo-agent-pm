#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

missing=0

require_file() {
  local path="$1"
  if [ ! -e "$path" ]; then
    echo "Missing: $path" >&2
    missing=1
  fi
}

require_file "$ROOT_DIR/docs/process/local-exchange.md"
require_file "$ROOT_DIR/scripts/setup-exchange.sh"
require_file "$ROOT_DIR/scripts/gitx-wrapper.sh"

if [ "$missing" -ne 0 ]; then
  echo "" >&2
  echo "Local Exchange files are missing. Reinstall the kit with overwrite to restore them." >&2
  exit 1
fi

chmod 755 "$ROOT_DIR/scripts/setup-exchange.sh" || true
chmod 755 "$ROOT_DIR/scripts/gitx-wrapper.sh" || true

echo ""
echo "Local Exchange files are present."
echo "Next: run ./scripts/setup-exchange.sh --wrapper-root <path> from any slot repo."
