#!/bin/bash
# Usage: ./scripts/run-prompt [--with-agents|--no-agents] <task_name>
# Example: ./scripts/run-prompt implement-one-todo
# Example: ./scripts/run-prompt --with-agents implement-one-todo

set -euo pipefail

INCLUDE_AGENTS="${RUN_PROMPT_INCLUDE_AGENTS:-0}"
TASK=""

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

CONFIG="$ROOT_DIR/scripts/context.config.yaml"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --with-agents)
      INCLUDE_AGENTS=1
      shift
      ;;
    --no-agents)
      INCLUDE_AGENTS=0
      shift
      ;;
    --help|-h)
      echo "Usage: $0 [--with-agents|--no-agents] <name>" >&2
      echo "  Looks for docs/ai/prompts/<name>.md or docs/ai/playbooks/<name>.md" >&2
      exit 0
      ;;
    *)
      TASK="$1"
      shift
      break
      ;;
  esac
done

if [ -z "$TASK" ]; then
  echo "Usage: $0 [--with-agents|--no-agents] <name>" >&2
  echo "  Looks for docs/ai/prompts/<name>.md or docs/ai/playbooks/<name>.md" >&2
  exit 1
fi

if [ ! -f "$CONFIG" ]; then
  echo "Error: Missing config file: $CONFIG" >&2
  exit 1
fi

TASK_FILE=""
if [ -f "$ROOT_DIR/docs/ai/prompts/$TASK.md" ]; then
  TASK_FILE="$ROOT_DIR/docs/ai/prompts/$TASK.md"
elif [ -f "$ROOT_DIR/docs/ai/playbooks/$TASK.md" ]; then
  TASK_FILE="$ROOT_DIR/docs/ai/playbooks/$TASK.md"
elif [ -f "$ROOT_DIR/docs/ai/instructions/$TASK.md" ]; then
  TASK_FILE="$ROOT_DIR/docs/ai/instructions/$TASK.md"
else
  echo "Error: Unknown name '$TASK'." >&2
  exit 1
fi

TASK_FILE_REF="$TASK_FILE"
if [[ "$TASK_FILE" == "$ROOT_DIR/"* ]]; then
  TASK_FILE_REF="${TASK_FILE#$ROOT_DIR/}"
fi

frontmatter_list() {
  local file="$1"
  local key="$2"
  awk -v want="$key" '
    function trim(s) { sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); return s }
    NR==1 { if ($0 != "---") { exit 0 } in_fm=1; next }
    in_fm && $0 == "---" { exit 0 }
    in_fm {
      if ($0 ~ /^[A-Za-z0-9_-]+:[[:space:]]*$/) {
        cur=$0
        sub(/:[[:space:]]*$/, "", cur)
        collect = (cur == want)
        next
      }
      if (collect && $0 ~ /^[[:space:]]*-[[:space:]]+/) {
        line=$0
        sub(/^[[:space:]]*-[[:space:]]+/, "", line)
        print trim(line)
      }
    }
  ' "$file" 2>/dev/null || true
}

frontmatter_scalar() {
  local file="$1"
  local key="$2"
  awk -v want="$key" '
    function trim(s) { sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); return s }
    NR==1 { if ($0 != "---") { exit 0 } in_fm=1; next }
    in_fm && $0 == "---" { exit 0 }
    in_fm {
      # scalar line: key: value
      if ($0 ~ "^"want":[[:space:]]*") {
        line=$0
        sub("^"want":[[:space:]]*", "", line)
        print trim(line)
        exit 0
      }
    }
  ' "$file" 2>/dev/null || true
}

cat_body() {
  local file="$1"
  awk '
    NR==1 && $0=="---" { in_fm=1; next }
    in_fm && $0=="---" { in_fm=0; next }
    !in_fm { print }
  ' "$file"
}

yaml_list_top() {
  local file="$1"
  local key="$2"
  awk -v want="$key" '
    function trim(s) { sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); return s }
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    $0 ~ "^"want":[[:space:]]*$" { in_list=1; next }
    in_list {
      if ($0 ~ /^[A-Za-z0-9_-]+:[[:space:]]*$/) { exit }
      if ($0 ~ /^[[:space:]]*-[[:space:]]+/) {
        line=$0
        sub(/^[[:space:]]*-[[:space:]]+/, "", line)
        print trim(line)
      }
    }
  ' "$file" 2>/dev/null || true
}

yaml_list_task() {
  local file="$1"
  local task="$2"
  awk -v want="$task" '
    function trim(s) { sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); return s }
    /^[[:space:]]*#/ { next }
    /^[[:space:]]*$/ { next }
    /^task_inputs:[[:space:]]*$/ { in_section=1; next }
    in_section && /^[[:space:]]*[A-Za-z0-9_-]+:[[:space:]]*$/ {
      cur=trim($0)
      sub(/:[[:space:]]*$/, "", cur)
      in_task = (cur == want)
      next
    }
    in_task && /^[[:space:]]*-[[:space:]]+/ {
      line=$0
      sub(/^[[:space:]]*-[[:space:]]+/, "", line)
      print trim(line)
    }
  ' "$file" 2>/dev/null || true
}

resolve_dep() {
  local ref="$1"
  local resolved=""

  case "$ref" in
    playbook/*)
      resolved="$ROOT_DIR/docs/ai/playbooks/${ref#playbook/}.md"
      ;;
    prompt/*)
      resolved="$ROOT_DIR/docs/ai/prompts/${ref#prompt/}.md"
      ;;
    instruction/*)
      resolved="$ROOT_DIR/docs/ai/instructions/${ref#instruction/}.md"
      ;;
    instructions/*)
      resolved="$ROOT_DIR/docs/ai/instructions/${ref#instructions/}.md"
      ;;
    /*)
      resolved="$ref"
      ;;
    *.md|*/*)
      resolved="$ROOT_DIR/$ref"
      ;;
    *)
      if [ -f "$ROOT_DIR/docs/ai/prompts/$ref.md" ]; then
        resolved="$ROOT_DIR/docs/ai/prompts/$ref.md"
      elif [ -f "$ROOT_DIR/docs/ai/playbooks/$ref.md" ]; then
        resolved="$ROOT_DIR/docs/ai/playbooks/$ref.md"
      elif [ -f "$ROOT_DIR/docs/ai/instructions/$ref.md" ]; then
        resolved="$ROOT_DIR/docs/ai/instructions/$ref.md"
      fi
      ;;
  esac

  printf "%s" "$resolved"
}

SEEN=""
VISITING=""
ORDER=()

list_has() {
  local list="$1"
  local needle="$2"
  printf '%s\n' "$list" | grep -Fxq "$needle"
}

list_add_unique() {
  local list="$1"
  local item="$2"
  if list_has "$list" "$item"; then
    printf '%s' "$list"
  else
    printf '%s%s\n' "$list" "$item"
  fi
}

list_remove_item() {
  local list="$1"
  local item="$2"
  local new_list=""
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    [ "$line" = "$item" ] && continue
    new_list="${new_list}${line}\n"
  done <<EOF
${list}
EOF
  printf '%s' "$new_list"
}

resolve_file() {
  local file="$1"

  if list_has "$SEEN" "$file"; then
    return 0
  fi
  if list_has "$VISITING" "$file"; then
    echo "Error: dependency cycle detected at $file" >&2
    exit 1
  fi

  VISITING="$(list_add_unique "$VISITING" "$file")"
  while IFS= read -r dep; do
    [ -z "$dep" ] && continue
    dep_file=$(resolve_dep "$dep")
    if [ -z "$dep_file" ] || [ ! -f "$dep_file" ]; then
      echo "Warning: dependency '$dep' not found." >&2
      continue
    fi
    resolve_file "$dep_file"
  done <<< "$(frontmatter_list "$file" depends_on)"

  VISITING="$(list_remove_item "$VISITING" "$file")"
  SEEN="$(list_add_unique "$SEEN" "$file")"
  ORDER+=("$file")
}

resolve_file "$TASK_FILE"

ALL_INPUTS=""

if [ "$INCLUDE_AGENTS" = "1" ]; then
  AGENTS_FILE="$ROOT_DIR/AGENTS.md"
  if [ -f "$AGENTS_FILE" ]; then
    ALL_INPUTS="$ALL_INPUTS$AGENTS_FILE\n"
  else
    echo "Warning: AGENTS.md not found at $AGENTS_FILE (skipping)." >&2
  fi
fi

# Include dependencies first, then the selected task file.
for f in "${ORDER[@]}"; do
  f_ref="$f"
  if [[ "$f" == "$ROOT_DIR/"* ]]; then
    f_ref="${f#$ROOT_DIR/}"
  fi
  ALL_INPUTS="$ALL_INPUTS$f_ref\n"
done

# Baseline inputs declared in the prompt/playbook frontmatter (including dependencies).
for f in "${ORDER[@]}"; do
  ALL_INPUTS="$ALL_INPUTS$(frontmatter_list "$f" inputs)\n"
done

# Project-level additions.
ALL_INPUTS="$ALL_INPUTS$(yaml_list_top "$CONFIG" instructions)\n"
ALL_INPUTS="$ALL_INPUTS$(yaml_list_top "$CONFIG" global_inputs)\n"
ALL_INPUTS="$ALL_INPUTS$(yaml_list_task "$CONFIG" "$TASK")\n"

DEDUPED=$(printf "%b" "$ALL_INPUTS" | awk 'NF && !seen[$0]++')

echo ""
echo ""

while IFS= read -r file; do
  # Resolve relative paths against the project root.
  if [[ "$file" != /* ]]; then
    file="$ROOT_DIR/$file"
  fi

  display="$file"
  if [[ "$file" == "$ROOT_DIR/"* ]]; then
    display="${file#$ROOT_DIR/}"
  fi

  if [ -d "$file" ]; then
    # If it's a directory, concat all markdown files inside
    if compgen -G "$file/*.md" > /dev/null; then
      for f in "$file"/*.md; do
        f_display="$f"
        if [[ "$f" == "$ROOT_DIR/"* ]]; then
          f_display="${f#$ROOT_DIR/}"
        fi

        kind=$(frontmatter_scalar "$f" kind)
        mode=$(frontmatter_scalar "$f" mode)
        name=$(frontmatter_scalar "$f" name)

        meta=""
        if [ -n "$kind" ] || [ -n "$mode" ] || [ -n "$name" ]; then
          meta=" (kind=${kind:-?} mode=${mode:-?} name=${name:-?})"
        fi
        echo "---"
        echo "File: $f_display$meta"
        echo "---"
        cat_body "$f"
        echo ""
      done
    else
      echo "---"
      echo "Dir:  $file (no .md files)"
      echo "---"
      echo ""
    fi
  elif [ -f "$file" ]; then
    kind=$(frontmatter_scalar "$file" kind)
    mode=$(frontmatter_scalar "$file" mode)
    name=$(frontmatter_scalar "$file" name)

    meta=""
    if [ -n "$kind" ] || [ -n "$mode" ] || [ -n "$name" ]; then
      meta=" (kind=${kind:-?} mode=${mode:-?} name=${name:-?})"
    fi
    echo "---"
    echo "File: $display$meta"
    echo "---"
    cat_body "$file"
    echo ""
  else
    echo "Warning: $file not found." >&2
  fi
done <<< "$DEDUPED"
